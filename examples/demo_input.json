      "input": {
        "image_path": "examples/demo_inputs/sample.jpg",
        "count": 1,
        "styles": null,
        "output_dir": "examples/demo_outputs/static_default_one"
      }
    },
    {
      "name": "static_recommend_three",
      "description": "上传一张图片，不指定风格，生成 3 张推荐风格静态壁纸",
      "service": "static",
      "input": {
        "image_path": "examples/demo_inputs/sample.jpg",
        "count": 3,
        "styles": null,
        "output_dir": "examples/demo_outputs/static_recommend_three"
      }
    },
    {
      "name": "static_custom_style_builtin",
      "description": "上传一张图片，指定风格库中已有风格",
      "service": "static",
      "input": {
        "image_path": "examples/demo_inputs/sample.jpg",
        "count": 1,
        "styles": [
          "makoto_shinkai"
        ],
        "output_dir": "examples/demo_outputs/static_custom_style_builtin"
      }
    },
    {
      "name": "static_custom_style_fallback",
      "description": "上传一张图片，指定一个风格库中不存在的风格，触发 LLM fallback prompt",
