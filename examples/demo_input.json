      "input": {
        "image_path": "examples/demo_inputs/sample.jpg",
        "count": 1,
        "styles": [
          "glass_hologram_future_city"
        ],
        "output_dir": "examples/demo_outputs/static_custom_style_fallback"
      }
    },
    {
      "name": "live_script_only",
